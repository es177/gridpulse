#!/bin/sh
# Keep personal email addresses out of author and committer metadata.
for identity in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  email=$(git var "$identity" | sed -n 's/.*<\([^>]*\)>.*/\1/p')
  case "$email" in
    anonymous@example.invalid) ;;
    *) echo "Commit blocked: author and committer must be Anonymous <anonymous@example.invalid>." >&2; exit 1 ;;
  esac
done

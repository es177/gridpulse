#!/bin/sh
# Keep personal email addresses out of author and committer metadata.
for identity in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  email=$(git var "$identity" | sed -n 's/.*<\([^>]*\)>.*/\1/p')
  case "$email" in
    anonymous@example.invalid|*@users.noreply.github.com) ;;
    *) echo "Commit blocked: use an anonymous or noreply author/committer address." >&2; exit 1 ;;
  esac
done
